# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual Environments
venv/
env/
ENV/
env.bak/
venv.bak/

# SQLite Database
*.db
*.sqlite3

# Output files (Charts, CSVs)
output/
stock_list_cache.json

# IDEs
.idea/
.vscode/settings.local.json

# OS generated files
.DS_Store
Thumbs.db

# Local logs and temp files
logs/
scratch/

# SQLite WAL/SHM sidecars
*.db-wal
*.db-shm

# Linux FUSE 掛載殘留檔 (Cowork/遠端存取產生)
.fuse_hidden*

# Git 鎖檔搬移暫存區 (唯讀掛載無法刪除時使用)
.git/_stale/

# 研究用的中介資料（可由腳本重建）
research/data/

# 個人持倉紀錄（程式會在缺檔時自動以空清單啟動）
my_positions.json
